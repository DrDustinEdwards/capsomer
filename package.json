{
  "name": "capsomer",
  "version": "0.148.1",
  "description": "Capsomer: the shared design system for Dustin Edwards's apps. Tokens, components and patterns, in plain CSS with optional behavior modules and React wrappers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrDustinEdwards/capsomer.git"
  },
  "bin": {
    "capsomer": "./bin/capsomer.mjs",
    "capsomer-roundtrip": "./bin/roundtrip.mjs"
  },
  "files": [
    "css",
    "fonts",
    "tokens/*.css",
    "tokens/tokens.json",
    "tokens/palette.mjs",
    "tokens/palette-core.mjs",
    "tokens/palette-core.d.mts",
    "tokens/token-check.mjs",
    "tokens/token-check.d.mts",
    "tokens/chart.mjs",
    "tokens/scale.mjs",
    "tokens/enarratio-theme.mjs",
    "tokens/enarratio-theme.d.mts",
    "tokens/fallback-fonts.mjs",
    "tokens/fallback-fonts.d.mts",
    "components/*/*.css",
    "components/*/*.md",
    "components/*/*-sw.js",
    "components/icons/LICENSE-lucide.txt",
    "dist",
    "bin",
    "DEFAULTS.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/components/chart-frame/chart-enhance.js",
    "./components/chart-frame/chart-enhance.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./parts.json": "./dist/parts.json",
    "./layers.css": "./css/layers.css",
    "./tokens.css": "./css/tokens.css",
    "./base.css": "./css/base.css",
    "./utilities.css": "./css/utilities.css",
    "./layout.css": "./css/layout.css",
    "./layout-gap.css": "./css/layout-gap.css",
    "./layout-stack.css": "./css/layout-stack.css",
    "./layout-cluster.css": "./css/layout-cluster.css",
    "./layout-spread.css": "./css/layout-spread.css",
    "./layout-grid.css": "./css/layout-grid.css",
    "./layout-panes.css": "./css/layout-panes.css",
    "./layout-items.css": "./css/layout-items.css",
    "./role-grid.css": "./components/people-roles/role-grid.css",
    "./plan-choice.css": "./components/price-card/plan-choice.css",
    "./feature-grid.css": "./components/feature/feature-grid.css",
    "./text.css": "./css/text.css",
    "./text-role.css": "./css/text-role.css",
    "./text-title.css": "./css/text-title.css",
    "./text-clamp.css": "./css/text-clamp.css",
    "./focus.css": "./css/focus.css",
    "./print.css": "./css/print.css",
    "./catalog-all.css": "./css/catalog-all.css",
    "./admin-all.css": "./css/admin-all.css",
    "./token-check": {
      "types": "./tokens/token-check.d.mts",
      "default": "./tokens/token-check.mjs"
    },
    "./build": {
      "types": "./bin/build.d.mts",
      "default": "./bin/build.mjs"
    },
    "./links.css": "./css/links.css",
    "./reset.css": "./css/reset.css",
    "./fonts.css": "./css/fonts.css",
    "./fonts-*.css": "./css/fonts-*.css",
    "./fallback-fonts.css": "./css/fallback-fonts.css",
    "./fonts/*": "./fonts/*",
    "./prose.css": "./css/prose.css",
    "./themes.css": "./tokens/themes.css",
    "./families.css": "./css/families.css",
    "./family-purple.css": "./tokens/family-purple.css",
    "./family-fox.css": "./tokens/family-fox.css",
    "./family-teal.css": "./tokens/family-teal.css",
    "./family-navy.css": "./tokens/family-navy.css",
    "./family-forest.css": "./tokens/family-forest.css",
    "./family-amber.css": "./tokens/family-amber.css",
    "./family-magenta.css": "./tokens/family-magenta.css",
    "./family-cerulean.css": "./tokens/family-cerulean.css",
    "./family-olive.css": "./tokens/family-olive.css",
    "./family-rose.css": "./tokens/family-rose.css",
    "./sites.css": "./css/sites.css",
    "./site-dustinedwards.css": "./tokens/site-dustinedwards.css",
    "./site-foxhound.css": "./tokens/site-foxhound.css",
    "./site-germomics.css": "./tokens/site-germomics.css",
    "./site-capsid.css": "./tokens/site-capsid.css",
    "./site-capsid-portal.css": "./tokens/site-capsid-portal.css",
    "./site-txasm.css": "./tokens/site-txasm.css",
    "./site-julieedwards.css": "./tokens/site-julieedwards.css",
    "./site-foxing.css": "./tokens/site-foxing.css",
    "./tokens.json": "./tokens/tokens.json",
    "./palette": "./tokens/palette.mjs",
    "./enarratio.css": "./css/enarratio.css",
    "./content": {
      "types": "./dist/components/content/content.d.ts",
      "default": "./dist/components/content/content.js"
    },
    "./email": {
      "types": "./dist/components/email/email.d.ts",
      "default": "./dist/components/email/email.js"
    },
    "./publish-transition": {
      "types": "./dist/components/publish-gate/publish-transition.d.ts",
      "default": "./dist/components/publish-gate/publish-transition.js"
    },
    "./confirm-server": {
      "types": "./dist/components/confirm-dialog/confirm-server.d.ts",
      "default": "./dist/components/confirm-dialog/confirm-server.js"
    },
    "./theme-server": {
      "types": "./dist/components/theme-switch/theme-server.d.ts",
      "default": "./dist/components/theme-switch/theme-server.js"
    },
    "./testing": {
      "types": "./dist/test/helpers.d.ts",
      "default": "./dist/test/helpers.js"
    },
    "./testing/page": {
      "types": "./dist/test/page.d.ts",
      "default": "./dist/test/page.js"
    },
    "./fonts": {
      "types": "./tokens/fallback-fonts.d.mts",
      "default": "./tokens/fallback-fonts.mjs"
    },
    "./enarratio-theme": {
      "types": "./tokens/enarratio-theme.d.mts",
      "default": "./tokens/enarratio-theme.mjs"
    },
    "./ambient-base.css": "./components/ambient/ambient-base.css",
    "./ambient-hex-field.css": "./components/ambient/ambient-hex-field.css",
    "./ambient-blobs.css": "./components/ambient/ambient-blobs.css",
    "./ambient-equalizer.css": "./components/ambient/ambient-equalizer.css",
    "./*.css": "./components/*/*.css",
    "./behavior/chart-enhance": {
      "types": "./dist/components/chart-frame/chart-enhance.d.ts",
      "default": "./dist/components/chart-frame/chart-enhance.js"
    },
    "./behavior/system-model": {
      "types": "./dist/components/system-map/system-model.d.ts",
      "default": "./dist/components/system-map/system-model.js"
    },
    "./behavior/graph": {
      "types": "./dist/components/graph/graph.d.ts",
      "default": "./dist/components/graph/graph.js"
    },
    "./behavior/chart-presets": {
      "types": "./dist/components/chart-frame/chart-presets.d.ts",
      "default": "./dist/components/chart-frame/chart-presets.js"
    },
    "./behavior/media-picker": {
      "types": "./dist/components/media-library/media-picker.d.ts",
      "default": "./dist/components/media-library/media-picker.js"
    },
    "./react/media-picker": {
      "types": "./dist/components/media-library/media-picker.react.d.ts",
      "default": "./dist/components/media-library/media-picker.react.js"
    },
    "./behavior/checklist-run-model": {
      "types": "./dist/components/checklist-run/checklist-run-model.d.ts",
      "default": "./dist/components/checklist-run/checklist-run-model.js"
    },
    "./push-sw.js": "./components/web-push/push-sw.js",
    "./offline-sw.js": "./components/offline-keep/offline-sw.js",
    "./behavior/command-host": {
      "types": "./dist/components/command-menu/command-host.d.ts",
      "default": "./dist/components/command-menu/command-host.js"
    },
    "./behavior/*": {
      "types": "./dist/components/*/*.d.ts",
      "default": "./dist/components/*/*.js"
    },
    "./react/player-context": {
      "types": "./dist/components/player/player-context.react.d.ts",
      "default": "./dist/components/player/player-context.react.js"
    },
    "./react/command-host": {
      "types": "./dist/components/command-menu/command-host.react.d.ts",
      "default": "./dist/components/command-menu/command-host.react.js"
    },
    "./react/*": {
      "types": "./dist/components/*/*.react.d.ts",
      "default": "./dist/components/*/*.react.js"
    }
  },
  "scripts": {
    "tokens": "node tokens/palette.mjs && node tokens/scale.mjs && node tokens/sites.mjs && node tokens/fonts.mjs",
    "check": "node tokens/palette.mjs --check && node tokens/palette.mjs --report --summary && node tokens/scale.mjs --check && node tokens/sites.mjs --check && node tokens/fonts.mjs --check && node bin/capsomer.mjs docs && node --test test/unit/*.test.mjs && tsc --noEmit -p tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "build": "tsc -p tsconfig.build.json && node bin/capsomer.mjs parts --out dist/parts.json",
    "prepare": "npm run build",
    "states": "node bin/capsomer.mjs states",
    "frame-heights": "node scripts/frame-heights.mjs",
    "site": "node bin/capsomer.mjs states && node bin/capsomer.mjs site-data && vite build --config site/vite.config.ts && prelum-markdown --dir site-dist --origin https://capsomer.dustinedwards.info && prelum-lastmod --dir site-dist --origin https://capsomer.dustinedwards.info && site-runtime-headers --site capsomer --out site-dist/_headers --header \"tdm-reservation: 1\"",
    "deploy": "wrangler deploy",
    "e2e": "node bin/capsomer.mjs states && playwright test",
    "palette-report": "node tokens/palette.mjs --report",
    "size": "node bin/capsomer.mjs size",
    "knip": "knip",
    "knip:internal": "knip --config knip.internal.json",
    "jscpd": "jscpd --config .jscpd.json",
    "weight": "node bin/capsomer.mjs weight",
    "loc": "node bin/capsomer.mjs loc",
    "bloat": "node bin/capsomer.mjs bloat --knip test-results/knip.json --jscpd test-results/jscpd/jscpd-report.json",
    "token-check": "node bin/capsomer.mjs token-check",
    "changeset": "changeset"
  },
