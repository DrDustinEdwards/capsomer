// Capsomer's site at https://capsomer.dustinedwards.info (rulings.md, rule 16): Workers static
// assets serving the built site from site-dist, with a tiny Worker (worker/index.ts) that
// receives Content-Security-Policy violation reports and sends the 404 page. Cloudflare's Git integration builds and
// deploys it from this public repo on every push to main (see DEPLOY.md). No account id or
// secret here: wrangler takes the account from the login or the build.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capsomer",
  "compatibility_date": "2026-09-30",
  "main": "./worker/index.ts",
  "minify": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./site-dist",
    "binding": "ASSETS",
    // The Worker runs first only for the report endpoint; every file is served by the assets layer
    // directly, with the headers site-dist/_headers sets (written by scripts/security-headers.ts).
    "run_worker_first": ["/csp-report"],
    // A missing file goes to the Worker, which sends the 404 page with its charset (no
    // _headers rule matches a path with no file). The site routes with #, so there is no
    // client route to fall back to.
    "not_found_handling": "none"
  },
  // At most 60 violation reports a minute from one address reach the log (worker/index.ts); the rest still get 204.
  // namespace_id is this site's own: sites sharing one share counters.
  "ratelimits": [{ "name": "CSP_REPORT_RATE_LIMIT", "namespace_id": "7801", "simple": { "limit": 60, "period": 60 } }],
  // Workers Logs keep the Worker's own lines, which are the violation reports. Invocation logs
  // (one per request) stay off: the site records nothing about its readers.
  "observability": { "logs": { "enabled": true, "invocation_logs": false } }
}
