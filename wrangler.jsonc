// Capsomer's site at https://capsomer.dustinedwards.info (rulings.md, rule 16): Workers static
// assets serving the built site from site-dist, with site-runtime's staticSite Worker (worker/index.ts) in front of
// every page: /health, the report endpoint, the prefetch rules, the page headers and the 404 page. devkit's shared deploy
// (ci.yml's deploy job) deploys it on every push to main (see DEPLOY.md). No account id or
// secret here: wrangler takes the account from the login or the build.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capsomer",
  "compatibility_date": "2026-09-30",
  "main": "./worker/index.ts",
  "minify": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./site-dist",
    "binding": "ASSETS",
    // The Worker runs first for every page; the hashed files under /assets/ are served by the assets layer
    // directly, with the headers site-dist/_headers sets (written by site-runtime-headers from the site registry).
    "run_worker_first": ["/*", "!/assets/*"],
    // A missing file gets the Worker's 404 page, private and never stored. The site routes with #, so there is no
    // client route to fall back to.
    "not_found_handling": "none"
  },
  // At most 60 violation reports a minute from one address reach the log (worker/index.ts); the rest still get 204.
  // namespace_id is this site's own: sites sharing one share counters.
  "ratelimits": [{ "name": "CSP_REPORT_RATE_LIMIT", "namespace_id": "7801", "simple": { "limit": 60, "period": 60 } }],
  // Workers Logs keep the Worker's own lines, which are the violation reports. Invocation logs
  // (one per request) stay off: the site records nothing about its readers.
  "observability": { "logs": { "enabled": true, "invocation_logs": false } }
}
