{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "components/*/*.ts",
    "components/*/*.react.tsx",
    "components/*/examples.html",
    "components/*/examples.tsx",
    "components/*/*.spec.ts",
    "site/main.tsx",
    "site/redirect.ts", "site/home-main.ts", "site/make-main.ts", "site/search-main.ts",
    "site/specimen.ts", "site/charts.ts",
    "site/*.spec.ts",
    "tokens/*.mjs",
    "test/**/*.{ts,mjs}"
  ],
  "project": ["**/*.{ts,tsx,mjs}"],
  "ignoreDependencies": ["@dustinedwards/devkit"]
}
