{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "components/*/*.ts",
    "components/*/*.react.tsx",
    "components/*/examples.html",
    "components/*/examples.tsx",
    "components/*/examples.build.tsx",
    "components/*/specimen/*.ts",
    "components/*/specimen/runtime/*.mjs",
    "components/*/*.spec.ts",
    "site/search-main.ts",
    "site/specimen.ts",
    "site/charts.ts",
    "site/*.spec.ts",
    "tokens/*.mjs",
    "test/**/*.{ts,mjs}"
  ],
  "project": ["**/*.{ts,tsx,mjs}"]
}
