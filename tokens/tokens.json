{
  "$description": "Capsomer tokens. Generated by tokens/scale.mjs; the CSS files are the contract. type and control show the compact density; density-compact and density-comfortable hold both sets.",
  "space": {
    "space-1": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      },
      "$description": "hairline gaps: an icon beside its count"
    },
    "space-2": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$description": "inside a control: icon to label"
    },
    "space-3": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      },
      "$description": "between controls in a toolbar"
    },
    "space-4": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      },
      "$description": "between rows of a form, cell padding"
    },
    "space-5": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "panel padding, the page gutter on a phone"
    },
    "space-6": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "between panels, the page gutter"
    },
    "space-7": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      },
      "$description": "between sections"
    },
    "space-8": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$description": "between major regions of a reading page"
    },
    "space-9": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      },
      "$description": "above a page footer"
    }
  },
  "radius": {
    "radius-s": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      },
      "$description": "kbd, chips inside text"
    },
    "radius-m": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      },
      "$description": "controls"
    },
    "radius-l": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      },
      "$description": "panels and dialogs"
    },
    "radius-xl": {
      "$type": "dimension",
      "$value": {
        "value": 14,
        "unit": "px"
      },
      "$description": "cards (shadcn's rounded-xl)"
    },
    "radius-full": {
      "$type": "dimension",
      "$value": {
        "value": 999,
        "unit": "px"
      },
      "$description": "pills and switches"
    }
  },
  "type": {
    "fs-label": {
      "$value": "11px",
      "$description": "column labels and section titles, uppercase; nothing is set smaller"
    },
    "fs-detail": {
      "$value": "13px",
      "$description": "the line under a row title"
    },
    "fs-body": {
      "$value": "14px",
      "$description": "app body and rows (vega's text-sm)"
    },
    "fs-lead": {
      "$value": "15px",
      "$description": "a page's lead line"
    },
    "fs-h3": {
      "$value": "18px",
      "$description": "a panel or dialog title"
    },
    "fs-h2": {
      "$value": "22px",
      "$description": "a page title in the app"
    },
    "fs-prose": {
      "$value": "clamp(17px, 1rem + 0.25vw, 19px)",
      "$description": "body text in the reading context"
    },
    "fs-prose-h2": {
      "$value": "clamp(22px, 1.2rem + 1.2vw, 30px)",
      "$description": "a heading in the reading context"
    },
    "fs-input-coarse": {
      "$value": "16px",
      "$description": "a form input on a touch screen, so iOS does not zoom"
    },
    "prose": {
      "$value": "\"Source Serif 4\", \"Iowan Old Style\", Charter, Georgia, serif",
      "$description": "long-form text and public headings (decision 5)"
    },
    "display": {
      "$value": "\"Schibsted Grotesk\", \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
      "$description": "a heading that wants a display face (the page head's title, an app's own headings); Schibsted Grotesk at 800, the UI face's own heavy weight; a site may set its own"
    }
  },
  "motion": {
    "dur-fast": {
      "$type": "duration",
      "$value": {
        "value": 100,
        "unit": "ms"
      },
      "$description": "feedback (hover, press) and every exit: what leaves goes faster than it came"
    },
    "dur-base": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      },
      "$description": "an overlay or a page arriving"
    },
    "dur-slow": {
      "$type": "duration",
      "$value": {
        "value": 400,
        "unit": "ms"
      },
      "$description": "a spring settling (with --ease-spring); a page-level change"
    },
    "ease-out": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ],
      "$description": "things arriving and leaving: a fast start and a long soft stop (Radix Themes, Arc)"
    },
    "ease-in-out": {
      "$type": "cubicBezier",
      "$value": [
        0.65,
        0,
        0.35,
        1
      ],
      "$description": "things moving within the page"
    },
    "ease-spring": {
      "$value": "linear(0, 0.005 1%, 0.028 2.5%, 0.117 5.5%, 0.572 16%, 0.77 21.5%, 0.839 24%, 0.906 27%, 0.956 30%, 0.992 33%, 1.012 35.5%, 1.026 38%, 1.035 41%, 1.038 44.5%, 1.035 49.5%, 1.012 63.5%, 1.003 72.5%, 0.999 84.5%, 1)",
      "$description": "a release or a thumb settling: a damped spring, 95% at 30% of the time, 4% past; transform only, with --dur-slow"
    }
  },
  "layer": {
    "z-base": {
      "$type": "number",
      "$value": 0,
      "$description": "the page"
    },
    "z-sticky": {
      "$type": "number",
      "$value": 20,
      "$description": "a sticky top bar or anchor bar"
    },
    "z-tabbar": {
      "$type": "number",
      "$value": 30,
      "$description": "the phone tab bar"
    },
    "z-overlay": {
      "$type": "number",
      "$value": 40,
      "$description": "a scrim and a side panel"
    },
    "z-message": {
      "$type": "number",
      "$value": 70,
      "$description": "the status region"
    },
    "z-tip": {
      "$type": "number",
      "$value": 80,
      "$description": "a tooltip"
    }
  },
  "focus": {
    "focus-width": {
      "$value": "2px",
      "$description": "the focus outline, WCAG 2.4.13's 2 px perimeter; its color is --ring, checked at 3:1 by palette.mjs"
    },
    "focus-offset": {
      "$value": "2px",
      "$description": "space between the control and its ring"
    },
    "ring-width": {
      "$value": "3px",
      "$description": "the soft glow around a focused field (shadcn's ring-3); the 2 px outline stays the focus indicator"
    }
  },
  "layout": {
    "measure": {
      "$value": "66ch",
      "$description": "a reading line (Bringhurst's 66 characters)"
    },
    "page-max": {
      "$value": "1064px",
      "$description": "the family page width, gutters included: the 1032px column holds the reading line (--measure, 686px at the 17px body) in two-thirds of it, GOV.UK's two-thirds rule, rounded to the 8px grid; every site's letterhead, content and footer line up on it (.cap-page; 2026-10-28)"
    },
    "page-gutter": {
      "$value": "16px",
      "$description": "the page's side margin inside --page-max, and the least margin at any width"
    },
    "rail-w": {
      "$value": "208px",
      "$description": "the shell's left menu, expanded"
    },
    "rail-w-collapsed": {
      "$value": "56px",
      "$description": "the shell's left menu, collapsed to icons"
    },
    "top-h": {
      "$value": "44px",
      "$description": "the shell's top bar (the Portal's, #215)"
    },
    "header-h": {
      "$value": "3.5rem",
      "$description": "the site header, 56px on every site and surface (docs/design/design-site-header.md, answer 6)"
    },
    "cap-arrow": {
      "$value": "polygon(8.3% 41.7%, 59.2% 41.7%, 40% 22.5%, 50% 12.5%, 87.5% 50%, 50% 87.5%, 40% 77.5%, 59.2% 58.3%, 8.3% 58.3%)",
      "$description": "the family arrow's shape, a clip path (css/base.css): a token so a page without base.css, such as the Portal, still draws the header's arrows"
    }
  },
  "touch": {
    "link-rule": {
      "$value": "0px",
      "$description": "the site header's section links: an underline that grows in under the pointer; 0 draws none"
    },
    "icon-radius": {
      "$value": "6px",
      "$description": "the site header's icon controls and the theme button (--radius-m; 999px for a circle)"
    },
    "icon-border": {
      "$value": "0px",
      "$description": "their outline's width, in the band's line"
    },
    "theme-turn": {
      "$value": "0deg",
      "$description": "the theme button turns this far under the pointer"
    },
    "arrow-rest": {
      "$value": "1",
      "$description": "a .cap-arrow's opacity at rest; 0 lets it slide in under the pointer"
    },
    "arrow-shift": {
      "$value": "0px",
      "$description": "how far back a .cap-arrow sits at rest"
    },
    "card-lift": {
      "$value": "0px",
      "$description": "how far a linked panel (a.cap-panel) rises under the pointer; a negative length lifts it"
    },
    "card-edge": {
      "$value": "0",
      "$description": "a linked panel's edge under the pointer: 0 the strong line, 1 the accent, between them a mix"
    },
    "card-shadow": {
      "$value": "none",
      "$description": "a panel's resting shadow"
    },
    "btn-sweep": {
      "$value": "0",
      "$description": "the default button fills with the primary color from the left under the pointer: 0 off, 1 on"
    }
  },
