{
  "$description": "Capsomer tokens. Generated by tokens/scale.mjs; the CSS files are the contract.",
  "space": {
    "space-1": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      },
      "$description": "hairline gaps: an icon beside its count"
    },
    "space-2": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$description": "inside a control: icon to label"
    },
    "space-3": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      },
      "$description": "between controls in a toolbar"
    },
    "space-4": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      },
      "$description": "between rows of a form, cell padding"
    },
    "space-5": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "panel padding, the page gutter on a phone"
    },
    "space-6": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "between panels, the page gutter"
    },
    "space-7": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      },
      "$description": "between sections"
    },
    "space-8": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$description": "between major regions of a reading page"
    },
    "space-9": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      },
      "$description": "above a page footer"
    }
  },
  "radius": {
    "radius-s": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      },
      "$description": "kbd, chips inside text"
    },
    "radius-m": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      },
      "$description": "controls"
    },
    "radius-l": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      },
      "$description": "panels and dialogs"
    },
    "radius-full": {
      "$type": "dimension",
      "$value": {
        "value": 999,
        "unit": "px"
      },
      "$description": "pills and switches"
    }
  },
  "type": {
    "fs-label": {
      "$value": "11px",
      "$description": "column labels and section titles, uppercase; nothing is set smaller"
    },
    "fs-detail": {
      "$value": "12px",
      "$description": "the line under a row title"
    },
    "fs-body": {
      "$value": "13px",
      "$description": "app body and rows"
    },
    "fs-lead": {
      "$value": "15px",
      "$description": "a page's lead line"
    },
    "fs-h3": {
      "$value": "18px",
      "$description": "a panel or dialog title"
    },
    "fs-h2": {
      "$value": "22px",
      "$description": "a page title in the app"
    },
    "fs-prose": {
      "$value": "clamp(17px, 1rem + 0.25vw, 19px)",
      "$description": "body text in the reading context"
    },
    "fs-prose-h2": {
      "$value": "clamp(22px, 1.2rem + 1.2vw, 30px)",
      "$description": "a heading in the reading context"
    },
    "fs-input-coarse": {
      "$value": "16px",
      "$description": "a form input on a touch screen, so iOS does not zoom"
    },
    "prose": {
      "$value": "\"Source Serif 4\", \"Iowan Old Style\", Charter, Georgia, serif",
      "$description": "long-form text and public headings (decision 5)"
    }
  },
  "control": {
    "control-h": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      },
      "$description": "a control's height with a fine pointer"
    },
    "control-h-coarse": {
      "$type": "dimension",
      "$value": {
        "value": 44,
        "unit": "px"
      },
      "$description": "a control's height with a coarse pointer"
    },
    "target": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "the smallest hit area, WCAG 2.5.8"
    }
  },
  "motion": {
    "dur-fast": {
      "$type": "duration",
      "$value": {
        "value": 100,
        "unit": "ms"
      },
      "$description": "feedback: hover, press, a switch moving"
    },
    "dur-base": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      },
      "$description": "a panel, dialog or menu opening"
    },
    "dur-slow": {
      "$type": "duration",
      "$value": {
        "value": 400,
        "unit": "ms"
      },
      "$description": "a page-level change"
    },
    "ease-out": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0.38,
        0.9
      ],
      "$description": "things arriving"
    },
    "ease-in-out": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0.38,
        0.9
      ],
      "$description": "things moving within the page"
    }
  },
  "layer": {
    "z-base": {
      "$type": "number",
      "$value": 0,
      "$description": "the page"
    },
    "z-sticky": {
      "$type": "number",
      "$value": 20,
      "$description": "a sticky top bar or anchor bar"
    },
    "z-tabbar": {
      "$type": "number",
      "$value": 30,
