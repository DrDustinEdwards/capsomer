    },
    "z-tip": {
      "$type": "number",
      "$value": 80,
      "$description": "a tooltip"
    }
  },
  "focus": {
    "focus-width": {
      "$value": "2px",
      "$description": "the focus ring, WCAG 2.4.13's 2 px perimeter"
    },
    "focus-offset": {
      "$value": "2px",
      "$description": "space between the control and its ring"
    },
    "focus-color": {
